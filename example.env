VITE_TMDB_READ_API_KEY=...
VITE_OPENSEARCH_ENABLED=false

# CORS Proxy URLs - supports multiple proxies for automatic rotation and failover
# Single proxy: VITE_CORS_PROXY_URL=https://your-proxy.com
# Multiple proxies (comma-separated): VITE_CORS_PROXY_URL=https://proxy1.com,https://proxy2.com,https://proxy3.com
# Make sure proxy URLs do NOT have a slash at the end
VITE_CORS_PROXY_URL=...

# M3U8 Proxy URLs - supports multiple proxies for automatic rotation and failover  
# Single proxy: VITE_M3U8_PROXY_URL=https://your-m3u8-proxy.com
# Multiple proxies (comma-separated): VITE_M3U8_PROXY_URL=https://m3u8-proxy1.com,https://m3u8-proxy2.com
# Make sure proxy URLs do NOT have a slash at the end
VITE_M3U8_PROXY_URL=...

# make sure the domain does NOT have a slash at the end
VITE_APP_DOMAIN=http://localhost:5173

# App name - customize your application name
VITE_APP_NAME=P-Stream

# External URLs - customize these links for your deployment
VITE_DISCORD_URL=https://discord.gg/7z6znYgrTG
VITE_GITHUB_URL=https://github.com/p-stream/p-stream
VITE_FEBBOX_URL=https://febbox.com
VITE_DOCS_URL=https://docs.pstream.mov
VITE_REAL_DEBRID_URL=https://real-debrid.com
